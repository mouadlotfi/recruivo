# Dependencies are installed inside the image or a development volume.
node_modules/
vendor/

# Never send secrets or local environment files to the build context.
.env*
!.env.example

# Generated files and mutable runtime data.
storage/*
!storage/.gitignore
data/
bootstrap/cache/*.php
public/build/
public/hot
public/storage

# Local logs and caches.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.phpunit.result.cache
.phpunit.*.xml

# Tests and development-only repository files are mounted in development.
tests/
phpunit.xml
.hermes/
.ai/

# Git, CI, IDE, and OS files.
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/
.phpstorm.meta.php
_ide_helper*.php
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db
desktop.ini

# Compose files and documentation are not needed in the runtime image.
compose*.yaml
compose*.yml
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
*.md

# Docker and deployment artifacts.
Dockerfile*
.dockerignore
deploy/
backups/
*.tmp
*.temp
*.cache
auth.json
.vagrant/
Homestead.json
Homestead.yaml
Vagrantfile