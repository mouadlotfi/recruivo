APP_NAME="Recruivo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_BIND_IP=0.0.0.0

COMPOSE_PROFILES=infra
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Environment / demo flags --------------------------------------------------
APP_IS_DEMO=false
DEMO_SCHEDULED_RESET=false

# --- Database -----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=recruivo_db
DB_USERNAME=recruivo
DB_PASSWORD=secret

# --- Cache / Queue / Session (Redis) ------------------------------------------
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@recruivo.work"
MAIL_FROM_NAME="${APP_NAME}"

# --- Analytics (Umami, self-hosted) -------------------------------------------
# Leave UMAMI_WEBSITE_ID empty to disable tracking entirely (as in local dev).
# UMAMI_DOMAINS scopes the tracker to those hostnames (comma-delimited) so a
# staging or LAN host cannot report into production; each deployed stack sets
# its own (recruivo.work for prod, demo.recruivo.work for the demo stack).
# UMAMI_UPSTREAM is only read by Caddy inside the app container: the host and port
# where Umami answers (host.docker.internal reaches a port published on this host).
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=/u/script.js
UMAMI_DOMAINS=recruivo.work
UMAMI_UPSTREAM=host.docker.internal:3000

# --- Backups (spatie/laravel-backup) ------------------------------------------
# BACKUP_ENABLED=false disables every backup command. The Demo environment sets
# this: demo:reset rebuilds its database nightly.
# BACKUP_DIR is bind-mounted to /backups inside the app; BACKUP_DISK_ROOT is the
# path laravel-backup writes to inside the container. Both must be set to
# persistent absolute paths in deployment - the relative default resolves inside
# the CI runner's checkout, which is wiped on every deploy.
# BACKUP_ARCHIVE_PASSWORD encrypts each archive. Keep a copy in a password
# manager: without it the archive cannot be opened, including the copy of this
# file that the archive contains.
# BACKUP_ENV_FILE is the deployment env file, mounted read-only so the backup can
# include it. Leave it empty and the file is simply not included.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_DISK_ROOT=/backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ENV_FILE=/etc/recruivo/deployment.env

# --- Security & CORS ----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000
FRONTEND_URLS=http://localhost:3000
QUEUE_FAILED_DRIVER=database-uuids

# =============================================================================
# Environment Overrides Reference (Production / Demo)
# =============================================================================
# The deployed stacks do not read this file: each takes its values from the env
# file selected by the APP_ENV_FILE variable on the matching GitHub environment
# (production/demo). The blocks below show the expected shape, not live secrets.
#
# Production (recruivo.work):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://recruivo.work
#   SESSION_SECURE_COOKIE=true
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=...
#   MAIL_PASSWORD=...
#   MAIL_ENCRYPTION=tls
#
# Demo (demo.recruivo.work):
#   APP_ENV=demo
#   APP_IS_DEMO=true
#   APP_URL=https://demo.recruivo.work
#   DEMO_SCHEDULED_RESET=true
#   MAIL_MAILER=log

# =============================================================================
# Compose (host-side) variables - not read by the application
# =============================================================================
# APP_ENV_FILE is the file the containers read (`env_file:`). DB_HOST/REDIS_HOST
# and COMPOSE_PROFILES are instead resolved by compose *interpolation*, which only
# sees the shell environment or an `--env-file`; values placed solely in
# APP_ENV_FILE are discarded. Pass both when operating a stack manually:
#
#   APP_ENV_FILE=.env.production docker compose --env-file .env.production up -d
#
# Host written into Vite's hot file (the dev server's own address). Asset URLs are
# rewritten to the request host per request, so opening the dev site from another
# device already works without setting this; docker-compose.dev.yml passes it to
# the `vite` service.
# VITE_HMR_HOST=192.168.1.20
#
# APP_ENV_FILE=/path/to/env
# DB_HOST=postgres
# REDIS_HOST=redis
# COMPOSE_PROFILES=infra

