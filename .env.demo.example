# =============================================================================
# Recruivo — PUBLIC DEMO environment template
# =============================================================================
# Copy this file to `.env.demo` and fill in values for your demo deployment.
#
#   cp .env.demo.example .env.demo
#
# Run demo with:
#   docker compose -f compose.yml -f compose.demo.yml --env-file .env.demo up -d --build
#
# The compose.demo.yml overlay hard-codes APP_ENV=demo, APP_DEBUG=false,
# and isolated volume names so demo can NEVER accidentally connect to or
# share data with production.
# =============================================================================

APP_NAME="Recruivo (Demo)"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_IS_DEMO=true
APP_URL=https://demo.your-domain.example
DEMO_APP_PORT=8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (Isolated Demo DB) --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=recruivo_demo_db
DB_USERNAME=recruivo_demo
DB_PASSWORD=demo_secret
DB_ROOT_PASSWORD=demo_secret

# --- Cache / Queue / Session (Isolated Demo Redis) --------------------------
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Safe Email (Demo Mail Safety: log or sandboxed trap) --------------------
# In demo environment, emails are written to logs or sent to sandbox traps,
# NEVER to real external candidates or companies.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@recruivo.work"
MAIL_FROM_NAME="${APP_NAME}"

# --- Demo Scheduled Reset ---------------------------------------------------
# Automatically resets demo database and storage to canonical seed every night
DEMO_SCHEDULED_RESET=true

# --- Frontend / CORS -------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=demo.your-domain.example
FRONTEND_URLS=https://demo.your-domain.example

QUEUE_FAILED_DRIVER=database-uuids
